# ==============================================================================
# CONFIGURAÇÕES DO SINCRONIZADOR LEGALONE (PRODUÇÃO / DOCKER)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CREDENCIAIS LEGALONE
# ------------------------------------------------------------------------------
LEGALONE_EMAIL=usuario@advocacia.com.br
LEGALONE_PASSWORD=SuaSenhaAqui
LEGALONE_ACCESS_CODE=CodigoDoEscritorio
LEGALONE_BASE_URL=https://conecta-api.legalone.com.br
# LEGALONE_TENANT_ID= (Opcional, extraído automaticamente do JWT retornado)

# ------------------------------------------------------------------------------
# 2. NEXTCLOUD (WebDAV Interno)
# ------------------------------------------------------------------------------
# URL do Nextcloud interno (ex: https://nextcloud.empresa.local ou IP/porta)
NEXTCLOUD_URL=https://nextcloud.empresa.local
NEXTCLOUD_USER=usuario_nextcloud
# Recomenda-se gerar uma 'Senha de Aplicativo' (App Password) em:
# Configurações Pessoais -> Segurança -> Dispositivos e Sessões -> Criar nova senha de app
NEXTCLOUD_PASSWORD=SuaSenhaOuAppPasswordAqui
# Pasta remota onde os arquivos serão organizados
NEXTCLOUD_REMOTE_DIR=Processos_LegalOne
# Defina como 'false' caso seu servidor interno utilize certificado SSL autoassinado
NEXTCLOUD_VERIFY_SSL=true

# ------------------------------------------------------------------------------
# 3. SERVIÇO SMTP (E-MAILS & ALERTAS)
# ------------------------------------------------------------------------------
# O sistema testa a conexão SMTP no bootstrap; se falhar, o serviço não inicia.
SMTP_HOST=smtp.empresa.com.br
SMTP_PORT=587
SMTP_USER=notificacoes@empresa.com.br
SMTP_PASSWORD=SenhaSmtpAqui
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=LegalOne Sync <notificacoes@empresa.com.br>

# E-mail que receberá alertas críticos imediatos (ex: falha de login ou falha no Nextcloud)
ADMIN_EMAIL=admin.ti@empresa.com.br

# Lista de e-mails que receberão o relatório diário às 07:00 com resumo dos andamentos
# Pode ser informado separado por vírgula ou em formato JSON:
NOTIFICATION_EMAILS=advogado1@empresa.com.br, advogado2@empresa.com.br, diretoria@empresa.com.br

# ------------------------------------------------------------------------------
# 4. AGENDAMENTO E CONFIGURAÇÕES AVANÇADAS
# ------------------------------------------------------------------------------
SCHEDULE_TIME=07:00
TIMEZONE=America/Sao_Paulo
PAGE_LIMIT=18
# MAX_PAGES= (Opcional: limitar páginas para testes rápidos)
